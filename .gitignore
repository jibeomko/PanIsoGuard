# Build directories
/build*/
build*/
cmake-build-*/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake.stamp

# Compiled objects / binaries / libs
*.o
*.a
*.so
*.so.*
*.dylib
/panisoguard

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
wheelhouse/
_skbuild/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Large data / results (never commit cohort or benchmark data)
*.bam
*.bai
*.cram
*.crai
*.fa
*.fasta
*.fai
*.gbz
*.gfa
*.vcf
*.vcf.gz
results/
benchmark/**/data/

# ...but DO track the tiny bundled test fixtures
!tests/data/tiny/mini.bam
!tests/data/tiny/mini.bam.bai
!tests/data/tiny/*.fa
!tests/data/tiny/*.fai

# ...and the worked locus' toy data (tiny; rebuilt by examples/worked_locus/data/build_toy.sh)
!examples/worked_locus/data/*.fa
!examples/worked_locus/data/*.fai
!examples/worked_locus/data/*.bam
!examples/worked_locus/data/*.bai

# ...and DO track the curated benchmark result artifacts (small metrics/tables only;
# bulky regenerated intermediates stay ignored via benchmark/results/.gitignore +
# the *.fa/*.bam/... rules above).
!benchmark/results/
!tests/data/tiny/strand.bam
!tests/data/tiny/strand.bam.bai
